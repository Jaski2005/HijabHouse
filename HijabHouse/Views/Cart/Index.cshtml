@using System.Runtime.CompilerServices
@using Microsoft.EntityFrameworkCore;

@model List<HijabHouse.Models.CartItem>

@{
    ViewData["Title"] = "Shporta";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold">Shporta ime</h1>

        <p class="text-muted">
            Produktet që ke zgjedhur.
        </p>
    </div>

    @if (Model.Count == 0)
    {
        <div class="text-center py-5">

            <h4>Shporta jote eshte bosh.</h4>

            <p class="text-muted">
                Shiko koleksionin dhe zgjidh fustanin tënd të preferuar.
            </p>

            <a asp-controller="Home"
               asp-action="Collection"
               class="btn btn-dark">
               Shiko koleksionin
               </a>
        </div>
    }
    else
    {

        <div class="row">

            <div class="col-lg-8">

                @foreach (var item in Model)
                {
                    <div class="card mb-4 shadow-sm border-0 cart-item-card">
                        
                        <div class="row g-0 align-items-center">

                            <div class="col-md-3">

                                <img src="@item.Dress.ImageUrl"
                                     class="img-fluid cart-item-image"
                                     alt="@item.Dress.Name" />
                            </div>

                            <div class="col-md-6">

                                <div class="card-body">

                                    <h5 class="card-title fw-bold mb-2">
                                        @item.Dress.Name
                                    </h5>

                                    <p class="text-muted mb-1">
                                        @item.Dress.Description
                                    </p>

                                    <p class="fw-bold fs-5 mb-0">
                                        @item.Dress.Price €
                                    </p>

                                    <div class="d-flex align-items-center mt-3">

                                        <form asp-controller="Cart"
                                              asp-action="Decrease"
                                              method="post">

                                              <input type="hidden"
                                                     name="id"
                                                     value="@item.Id" />

                                              <button type="submit"
                                                      class="btn btn-outline-dark">
                                                      -
                                                 </button>
                                        </form>

                                        <span class="mx-3 fw-bold">
                                             @item.Quantity
                                        </span>

                                        <form asp-controller="Cart"
                                              asp-action="Increase"
                                              method="post">
                                              
                                              <input type="hidden"
                                                     name="id"
                                                     value="@item.Id" />

                                             <button type="submit"
                                                     class="btn btn-outline-dark">
                                                     +
                                                </button>
                                         </form>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-3 text-center">

                                <form asp-controller="Cart"
                                      asp-action="Remove"
                                      method="post">

                                      <input type="hidden"
                                             name="id"
                                             value="@item.Id" />

                                             <button type="submit"
                                                     class="btn btn-outline-danger">
                                                       Hiq
                                                     </button>
                                      </form>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="col-lg-4">

                <div class="card shadow-sm">

                    <div class="card shadow-sm border-0 cart-summary">

                        <h4 class="fw-bold">
                            Permbledhja
                        </h4>

                        <hr />

                        @{
                            decimal total = 0;

                            foreach (var item in Model)
                            {
                                total += item.Dress.Price * item.Quantity;
                            }
                        }

                        <div class="d-flex justify-content-between">

                            <span>Totali</span>

                            <strong>
                                @total €
                            </strong>

                        </div>

                        <a asp-controller="Home"
                           asp-action="Collection"
                           class="btn btn-outline-dark w-100 mt-4">
                             Vazhdo blerjen
                       </a>

                       <a asp-controller="Checkout"
                          asp-action="Index"
                          class="btn btn-dark w-100 mt-2">
                          Vazhdo te porosia
                       </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>