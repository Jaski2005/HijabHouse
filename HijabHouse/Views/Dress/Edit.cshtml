@model HijabHouse.Models.Dress

@{
    ViewData["Title"] = "Ndrysho fustanin";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <h2 class="fw-bold">Ndrysho fustanin</h2>

                        <p class="text-muted">
                            Ndrysho të dhënat e fustanit.
                        </p>
                    </div>

                    <form asp-controller="Dress"
                          asp-action="Edit"
                          method="post">

                          <input type="hidden" asp-for="Id" />

                          <div class="mb-3">
                            <label class="form-label">
                                Emri i fustanit
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   required />
                          </div>

                          <div class="mb-3">
                            <label class="form-label">
                                Cmimi
                            </label>

                            <input asp-for="Price"
                                   type="number"
                                   step="0.01"
                                   class="form-control"
                                   required />
                          </div>

                          <div class="mb-3">
                            <label class="form-label">
                                Pershkrimi
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      required></textarea>
                          </div>

                          <div class="mb-3">
                            <label class="form-label">
                                Materiali
                            </label>

                            <input asp-for="Material"
                                   class="form-control" />
                          </div>

                          <div class="mb-3">
                            <label class="form-label">
                                Ngjyra
                            </label>

                            <input asp-for="Color"
                                   class="form-control" />
                          </div>

                          <div class="mb-3">
                            <label class="form-label">
                                Fotoja
                            </label>

                            <input asp-for="ImageUrl"
                                   class="form-control" />
                          </div>

                          <div class="d-grid mt-4">

                            <button type="submit"
                                    class="btn btn-dark btn-lg">
                                    Ruaj ndryshimet
                            </button>

                          </div>

                    </form>

                </div>

            </div>

        </div>

    </div>
    
</div>